    ∃ d c : Nat → Int,
      (∀ n, 30000000 * d (n + 1) = 30000 * d n + 30000000 * c n) ∧
      (∀ n, 30000000 * c (n + 1) + 24965517600 ≥ 27832800 * c n) ∧
      d 0 ≤ 1000000 ∧ c 0 ≤ 39000 ∧
      sumTo d 93 ≤ 1541354 :=
    ⟨Wd1P, Wc1P, hexactW1P, hlowW1P, hd0W1P, hc0W1P,
      by have h := simExact1; omega⟩

