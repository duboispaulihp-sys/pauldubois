/-- Arm 2 perturbed singularity: the state row (bnd, tval, chat, dval) evolved
by exact integer arithmetic under an adversarial per-window source deficit of 84162012 on the
b-scale (b * chat(n+1) ≥ 94747 * chat n - 84162012); on the coupling scale the law reads
30000000 * chat(n+1) + 25248603600 ≥ 28424100 * chat n. The launch row is (39000, 1000, 39000, 1000000),
at both caps. This constructed trajectory is the minimal residue-pinned one: each chat
value is the law ceiling lifted by `patch` into the class forced by the coupling, and the
whole trajectory is simulated exactly below. It stays under the head: sumTo d 123 = 1696000. -/
def SP2 : Int × Int × Int × Int :=
  (39000, 1000, 39000, 1000000)

def stepW2P (s : Int × Int × Int × Int) : Int × Int × Int × Int :=
  ((94747 * s.2.2.1 + 99999 - 84162012) / 100000, (s.2.1 + s.2.2.1) / 1000,
   patch ((94747 * s.2.2.1 + 99999 - 84162012) / 100000) (0 - (s.2.1 + s.2.2.1) / 1000),
   s.2.1 + s.2.2.1)

def W2P : Nat → Int × Int × Int × Int
  | 0 => SP2
  | n + 1 => stepW2P (W2P n)

def Wb2P : Nat → Int := fun n => (W2P n).1
def Wt2P : Nat → Int := fun n => (W2P n).2.1
def Wc2P : Nat → Int := fun n => (W2P n).2.2.1
def Wd2P : Nat → Int := fun n => (W2P n).2.2.2

/-- invariantsW2P: the residue pinning, the pinned sum congruence, and the 1000-adic
filtration, the three structure facts that carry the construction (positivity is not
needed at this layer and is witnessed numerically by the simulated chain). -/
theorem invariantsW2P : ∀ n,
    Wc2P n = patch (Wb2P n) (0 - Wt2P n) ∧
    (Wt2P n + Wc2P n) % 1000 = 0 ∧
    Wd2P n = 1000 * Wt2P n := by
  intro n
  induction n with
  | zero =>
      have e1 : Wb2P 0 = 39000 := rfl
      have e2 : Wt2P 0 = 1000 := rfl
      have e3 : Wc2P 0 = 39000 := rfl
      have e4 : Wd2P 0 = 1000000 := rfl
      have hpinz : Wc2P 0 = patch (Wb2P 0) (0 - Wt2P 0) := by
        rw [e1, e2]
        have eval : patch 39000 ((0 : Int) - 1000) = 39000 := by unfold patch; omega
        rw [eval]
        exact e3
      have hp0 : Wc2P 0 % 1000 = 0 := by rw [e3]; omega
      have hmw0 : (1000 + Wc2P 0) % 1000 = 0 := by rw [e3]; omega
      have hmod0 : (Wt2P 0 + Wc2P 0) % 1000 = 0 := by rw [e2]; exact hmw0
      have hdd0 : Wd2P 0 = 1000 * Wt2P 0 := by omega
      exact ⟨hpinz, hmod0, hdd0⟩
  | succ m ih =>
      obtain ⟨hpin, hmod, hdd⟩ := ih
      have e1 : Wb2P (m + 1) = (94747 * Wc2P m + 99999 - 84162012) / 100000 := rfl
      have e2 : Wt2P (m + 1) = (Wt2P m + Wc2P m) / 1000 := rfl
      have e3 : Wc2P (m + 1) = patch (Wb2P (m + 1)) (0 - Wt2P (m + 1)) := rfl
      have e4 : Wd2P (m + 1) = Wt2P m + Wc2P m := rfl
      have pc := patchCongr (Wb2P (m + 1)) (0 - Wt2P (m + 1))
      have ms := modSumZero (Wt2P (m + 1))
      have e7 : (Wt2P (m + 1) + Wc2P (m + 1)) % 1000 = 0 := by omega
      have e8 : Wd2P (m + 1) = 1000 * Wt2P (m + 1) := by omega
      exact ⟨e3, e7, e8⟩

theorem lawW2P (n : Nat) : 30000000 * Wc2P (n + 1) + 25248603600 ≥ 28424100 * Wc2P n := by
  have iN := invariantsW2P n
  obtain ⟨hpinN, _, _⟩ := iN
  have e1 : Wb2P (n + 1) = (94747 * Wc2P n + 99999 - 84162012) / 100000 := rfl
  have e5law : 100000 * Wb2P (n + 1) ≥ 94747 * Wc2P n - 84162012 := by omega
  have iS := invariantsW2P (n + 1)
  obtain ⟨hpinS, _, _⟩ := iS
  have hpg := patchGe (Wb2P (n + 1)) (0 - Wt2P (n + 1))
  omega

theorem hlowW2P : ∀ n, 30000000 * Wc2P (n + 1) + 25248603600 ≥ 28424100 * Wc2P n := by
  intro n
  have law := lawW2P n
  omega

theorem hexactW2P : ∀ n, 30000000 * Wd2P (n + 1) = 30000 * Wd2P n + 30000000 * Wc2P n := by
  intro n
  have iN := invariantsW2P n
  obtain ⟨_, _, hdd⟩ := iN
  have e4 : Wd2P (n + 1) = Wt2P n + Wc2P n := rfl
  omega

