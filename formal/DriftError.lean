/-- Arm 1 perturbed singularity: the state row (bnd, tval, chat, dval) evolved
by exact integer arithmetic under an adversarial per-window source deficit of 10402299 on the
b-scale (b * chat(n+1) ≥ 11597 * chat n - 10402299); on the coupling scale the law reads
30000000 * chat(n+1) + 24965517600 ≥ 27832800 * chat n. The launch row is (39000, 1000, 39000, 1000000),
at both caps. This constructed trajectory is the minimal residue-pinned one: each chat
value is the law ceiling lifted by `patch` into the class forced by the coupling, and the
whole trajectory is simulated exactly below. It stays under the head: sumTo d 93 = 1526000. -/
def SP1 : Int × Int × Int × Int :=
  (39000, 1000, 39000, 1000000)

def stepW1P (s : Int × Int × Int × Int) : Int × Int × Int × Int :=
  ((11597 * s.2.2.1 + 12499 - 10402299) / 12500, (s.2.1 + s.2.2.1) / 1000,
   patch ((11597 * s.2.2.1 + 12499 - 10402299) / 12500) (0 - (s.2.1 + s.2.2.1) / 1000),
   s.2.1 + s.2.2.1)

def W1P : Nat → Int × Int × Int × Int
  | 0 => SP1
  | n + 1 => stepW1P (W1P n)

def Wb1P : Nat → Int := fun n => (W1P n).1
def Wt1P : Nat → Int := fun n => (W1P n).2.1
def Wc1P : Nat → Int := fun n => (W1P n).2.2.1
def Wd1P : Nat → Int := fun n => (W1P n).2.2.2

/-- invariantsW1P: the residue pinning, the pinned sum congruence, and the 1000-adic
filtration, the three structure facts that carry the construction (positivity is not
needed at this layer and is witnessed numerically by the simulated chain). -/
theorem invariantsW1P : ∀ n,
    Wc1P n = patch (Wb1P n) (0 - Wt1P n) ∧
    (Wt1P n + Wc1P n) % 1000 = 0 ∧
    Wd1P n = 1000 * Wt1P n := by
  intro n
  induction n with
  | zero =>
      have e1 : Wb1P 0 = 39000 := rfl
      have e2 : Wt1P 0 = 1000 := rfl
      have e3 : Wc1P 0 = 39000 := rfl
      have e4 : Wd1P 0 = 1000000 := rfl
      have hpinz : Wc1P 0 = patch (Wb1P 0) (0 - Wt1P 0) := by
        rw [e1, e2]
        have eval : patch 39000 ((0 : Int) - 1000) = 39000 := by unfold patch; omega
        rw [eval]
        exact e3
      have hp0 : Wc1P 0 % 1000 = 0 := by rw [e3]; omega
      have hmw0 : (1000 + Wc1P 0) % 1000 = 0 := by rw [e3]; omega
      have hmod0 : (Wt1P 0 + Wc1P 0) % 1000 = 0 := by rw [e2]; exact hmw0
      have hdd0 : Wd1P 0 = 1000 * Wt1P 0 := by omega
      exact ⟨hpinz, hmod0, hdd0⟩
  | succ m ih =>
      obtain ⟨hpin, hmod, hdd⟩ := ih
      have e1 : Wb1P (m + 1) = (11597 * Wc1P m + 12499 - 10402299) / 12500 := rfl
      have e2 : Wt1P (m + 1) = (Wt1P m + Wc1P m) / 1000 := rfl
      have e3 : Wc1P (m + 1) = patch (Wb1P (m + 1)) (0 - Wt1P (m + 1)) := rfl
      have e4 : Wd1P (m + 1) = Wt1P m + Wc1P m := rfl
      have pc := patchCongr (Wb1P (m + 1)) (0 - Wt1P (m + 1))
      have ms := modSumZero (Wt1P (m + 1))
      have e7 : (Wt1P (m + 1) + Wc1P (m + 1)) % 1000 = 0 := by omega
      have e8 : Wd1P (m + 1) = 1000 * Wt1P (m + 1) := by omega
      exact ⟨e3, e7, e8⟩

theorem lawW1P (n : Nat) : 30000000 * Wc1P (n + 1) + 24965517600 ≥ 27832800 * Wc1P n := by
  have iN := invariantsW1P n
  obtain ⟨hpinN, _, _⟩ := iN
  have e1 : Wb1P (n + 1) = (11597 * Wc1P n + 12499 - 10402299) / 12500 := rfl
  have e5law : 12500 * Wb1P (n + 1) ≥ 11597 * Wc1P n - 10402299 := by omega
  have iS := invariantsW1P (n + 1)
  obtain ⟨hpinS, _, _⟩ := iS
  have hpg := patchGe (Wb1P (n + 1)) (0 - Wt1P (n + 1))
  omega

theorem hlowW1P : ∀ n, 30000000 * Wc1P (n + 1) + 24965517600 ≥ 27832800 * Wc1P n := by
  intro n
  have law := lawW1P n
  omega

theorem hexactW1P : ∀ n, 30000000 * Wd1P (n + 1) = 30000 * Wd1P n + 30000000 * Wc1P n := by
  intro n
  have iN := invariantsW1P n
  obtain ⟨_, _, hdd⟩ := iN
  have e4 : Wd1P (n + 1) = Wt1P n + Wc1P n := rfl
  omega

theorem hd0W1P : Wd1P 0 ≤ 1000000 := by
  have h : Wd1P 0 = 1000000 := rfl
  omega

theorem hc0W1P : Wc1P 0 ≤ 39000 := by
  have h : Wc1P 0 = 39000 := rfl
  omega

