/-- Arm 3 perturbed singularity: the state row (bnd, tval, chat, dval) evolved
by exact integer arithmetic under an adversarial per-window source deficit of 86225119 on the
b-scale (b * chat(n+1) ≥ 95789 * chat n - 86225119); on the coupling scale the law reads
30000000 * chat(n+1) + 25867535700 ≥ 28736700 * chat n. The launch row is (39000, 1000, 39000, 1000000),
at both caps. This constructed trajectory is the minimal residue-pinned one: each chat
value is the law ceiling lifted by `patch` into the class forced by the coupling, and the
whole trajectory is simulated exactly below. It stays under the head: sumTo d 149 = 1908000. -/
def SP3 : Int × Int × Int × Int :=
  (39000, 1000, 39000, 1000000)

def stepW3P (s : Int × Int × Int × Int) : Int × Int × Int × Int :=
  ((95789 * s.2.2.1 + 99999 - 86225119) / 100000, (s.2.1 + s.2.2.1) / 1000,
   patch ((95789 * s.2.2.1 + 99999 - 86225119) / 100000) (0 - (s.2.1 + s.2.2.1) / 1000),
   s.2.1 + s.2.2.1)

def W3P : Nat → Int × Int × Int × Int
  | 0 => SP3
  | n + 1 => stepW3P (W3P n)

def Wb3P : Nat → Int := fun n => (W3P n).1
def Wt3P : Nat → Int := fun n => (W3P n).2.1
def Wc3P : Nat → Int := fun n => (W3P n).2.2.1
def Wd3P : Nat → Int := fun n => (W3P n).2.2.2

/-- invariantsW3P: the residue pinning, the pinned sum congruence, and the 1000-adic
filtration, the three structure facts that carry the construction (positivity is not
needed at this layer and is witnessed numerically by the simulated chain). -/
theorem invariantsW3P : ∀ n,
    Wc3P n = patch (Wb3P n) (0 - Wt3P n) ∧
    (Wt3P n + Wc3P n) % 1000 = 0 ∧
    Wd3P n = 1000 * Wt3P n := by
  intro n
  induction n with
  | zero =>
      have e1 : Wb3P 0 = 39000 := rfl
      have e2 : Wt3P 0 = 1000 := rfl
      have e3 : Wc3P 0 = 39000 := rfl
      have e4 : Wd3P 0 = 1000000 := rfl
      have hpinz : Wc3P 0 = patch (Wb3P 0) (0 - Wt3P 0) := by
        rw [e1, e2]
        have eval : patch 39000 ((0 : Int) - 1000) = 39000 := by unfold patch; omega
        rw [eval]
        exact e3
      have hp0 : Wc3P 0 % 1000 = 0 := by rw [e3]; omega
      have hmw0 : (1000 + Wc3P 0) % 1000 = 0 := by rw [e3]; omega
      have hmod0 : (Wt3P 0 + Wc3P 0) % 1000 = 0 := by rw [e2]; exact hmw0
      have hdd0 : Wd3P 0 = 1000 * Wt3P 0 := by omega
      exact ⟨hpinz, hmod0, hdd0⟩
  | succ m ih =>
      obtain ⟨hpin, hmod, hdd⟩ := ih
      have e1 : Wb3P (m + 1) = (95789 * Wc3P m + 99999 - 86225119) / 100000 := rfl
      have e2 : Wt3P (m + 1) = (Wt3P m + Wc3P m) / 1000 := rfl
      have e3 : Wc3P (m + 1) = patch (Wb3P (m + 1)) (0 - Wt3P (m + 1)) := rfl
      have e4 : Wd3P (m + 1) = Wt3P m + Wc3P m := rfl
      have pc := patchCongr (Wb3P (m + 1)) (0 - Wt3P (m + 1))
      have ms := modSumZero (Wt3P (m + 1))
      have e7 : (Wt3P (m + 1) + Wc3P (m + 1)) % 1000 = 0 := by omega
      have e8 : Wd3P (m + 1) = 1000 * Wt3P (m + 1) := by omega
      exact ⟨e3, e7, e8⟩

theorem lawW3P (n : Nat) : 30000000 * Wc3P (n + 1) + 25867535700 ≥ 28736700 * Wc3P n := by
  have iN := invariantsW3P n
  obtain ⟨hpinN, _, _⟩ := iN
  have e1 : Wb3P (n + 1) = (95789 * Wc3P n + 99999 - 86225119) / 100000 := rfl
  have e5law : 100000 * Wb3P (n + 1) ≥ 95789 * Wc3P n - 86225119 := by omega
  have iS := invariantsW3P (n + 1)
  obtain ⟨hpinS, _, _⟩ := iS
  have hpg := patchGe (Wb3P (n + 1)) (0 - Wt3P (n + 1))
  omega

theorem hlowW3P : ∀ n, 30000000 * Wc3P (n + 1) + 25867535700 ≥ 28736700 * Wc3P n := by
  intro n
