namespace DriftError

/-- Prefix sum: sumTo f K = f 0 + ... + f (K-1). -/
def sumTo (f : Nat → Int) : Nat → Int
  | 0 => 0
  | K + 1 => sumTo f K + f K

theorem sumToStep (f : Nat → Int) (K : Nat) : sumTo f (K + 1) = sumTo f K + f K := rfl

variable {dhat chat : Nat → Int}

/-- The constructed per-window error: `patch b p` lifts the law bound `b` into the
pinned residue class `p (mod 1000)`. The residue pinning `chat n ≡ -tval n (mod 1000)`
is in fact forced on every integer trajectory by the coupling recursion itself, so
`patch` is exactly the canonical way to realize it while keeping the floor law. -/
def patch (b p : Int) : Int := b + ((p - b) % 1000 + 1000) % 1000

theorem modRange (x : Int) : -999 ≤ x % 1000 ∧ x % 1000 ≤ 999 := by
  have h1 : -999 ≤ x % 1000 := by omega
  have h2 : x % 1000 ≤ 999 := by omega
  exact ⟨h1, h2⟩

theorem patchDeltaRange (b p : Int) : 0 ≤ patch b p - b ∧ patch b p - b ≤ 999 := by
  unfold patch
  have hr := modRange (p - b)
  have h1 : 0 ≤ patch b p - b := by unfold patch; omega
  have h2 : patch b p - b ≤ 999 := by unfold patch; omega
  exact ⟨h1, h2⟩

theorem patchGe (b p : Int) : b ≤ patch b p := by
  have h := patchDeltaRange b p
  omega

theorem patchCongr (b p : Int) : (patch b p) % 1000 = p % 1000 := by
  unfold patch
  omega

theorem modSumZero (t : Int) : (t + (0 - t) % 1000) % 1000 = 0 := by omega

