namespace ThresholdNo

/-- Prefix sum of the window sequence: sumTo f K = f 0 + ... + f (K-1). -/
def sumTo (f : Nat → Int) : Nat → Int
  | 0 => 0
  | K + 1 => sumTo f K + f K

variable {dhat chat : Nat → Int}

/-- Prefix sums are nondecreasing for nonnegative sequences. -/
theorem sumToMono (hnn : ∀ n, 0 ≤ dhat n) (K : Nat) :
    sumTo dhat K ≤ sumTo dhat (K + 1) := by
  have e : sumTo dhat (K + 1) = sumTo dhat K + dhat K := rfl
  have h := hnn K
  omega

/-- Window transfer: if every shifted window of f dominates the corresponding
window of g, then the prefix sums satisfy sumTo f (K+1) ≥ f 0 + sumTo g K.
Used with f = dhat, g = chat on the exact coupling recursion, this is the
conservative bridge that reads off only dhat(n+1) ≥ chat n and discards the
1000/999 feedback. -/
theorem shiftSum {f g : Nat → Int} (h : ∀ n, f (n + 1) ≥ g n) (K : Nat) :
    sumTo f (K + 1) ≥ f 0 + sumTo g K := by
  induction K with
  | zero =>
      have eF : sumTo f (0 + 1) = sumTo f 0 + f 0 := rfl
      have ez : sumTo f 0 = 0 := rfl
      have eG : sumTo g 0 = 0 := rfl
      omega
  | succ K ih =>
      have eF : sumTo f (K + 1 + 1) = sumTo f (K + 1) + f (K + 1) := rfl
      have eG : sumTo g (K + 1) = sumTo g K + g K := rfl
      have hg := h K
      omega

/-- Definitional step equation for sumTo, for literal instantiation downstream. -/
theorem sumToStep (f : Nat → Int) (K : Nat) : sumTo f (K + 1) = sumTo f K + f K := rfl

